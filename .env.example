# ============================================================================
# PLAYUP PRODUCTION ENVIRONMENT VARIABLES (.env.example)
# Copy to .env on the server ONLY — NEVER commit real secrets to GitHub!
# ============================================================================

# Application Public URL (used for webhooks & iOS WebClip profile)
APP_URL="https://votre-domaine-playup.com"
VITE_API_BASE_URL=""

# Backend Session Signing Secret (Server-side only — auto-generated if empty)
PLAYUP_SESSION_SECRET=""

# RechargeGames Official API & Webhook Secrets (Server-side only)
RECHARGEGAMES_API_KEY=""
RECHARGEGAMES_WEBHOOK_SECRET=""

# GoXtop Official API & Webhook Secrets (Server-side only)
GOXTOP_API_KEY=""
GOXTOP_WEBHOOK_SECRET=""

# Payment Gateways & Stripe Webhook Verification (Server-side only)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
MONCASH_CLIENT_ID=""
MONCASH_CLIENT_SECRET=""
NATCASH_API_KEY=""
NATCASH_SECRET=""

# Post-Delivery Email & Web Push Relay (Server-side only)
PLAYUP_EMAIL_WEBHOOK_URL=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Optional Gemini Server Key
GEMINI_API_KEY=""
