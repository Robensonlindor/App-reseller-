# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOXTOP API CONFIGURATION (Server-side only — never exposed to client)
GOXTOP_API_BASE_URL="https://goxtop.com"
GOXTOP_API_KEY=""
GOXTOP_WEBHOOK_SECRET=""

# RECHARGEGAMES API CONFIGURATION (Server-side only — never exposed to client or APK)
RECHARGEGAMES_API_KEY=
RECHARGEGAMES_WEBHOOK_SECRET=
RECHARGEGAMES_BASE_URL=

